node_modules/
**/renders/
**/.hyperframes/
__pycache__/
*.pyc
# Scratch voice clips are regenerated by tools/scratch_voice.py
amazon-hidden-tax/voiceover/steps/*.wav
amazon-hidden-tax/engine/amazon/assets/vo/
# Large source documents: re-download from the URLs in FACT_CHECK.md
amazon-hidden-tax/engine/paper/assets/docs/*.pdf
amazon-hidden-tax/engine/paper/assets/docs/complaint.txt
amazon-hidden-tax/engine/paper/assets/docs/p9_bbox.html
amazon-hidden-tax/voiceover/steps/
amazon-hidden-tax/paper_trail_style_reel.mp4
amazon-hidden-tax/engine/paper/assets/vo/
amazon-hidden-tax/amazon_hidden_tax_v1_preview.mp4
amazon-hidden-tax/amazon_hidden_tax_v2_preview.mp4
amazon-hidden-tax/engine/cartoon/assets/ep/
amazon-hidden-tax/engine/cartoon/renders/
channel-system/episodes/*/demo_preview.mp4
amazon-hidden-tax/amazon_hidden_tax_v3_preview.mp4
# Studio engine: episode audio is copied in by studio/tools/build.mjs
studio/assets/ep/
studio/renders/
channel-system/episodes/*/render/
# Sound: the mix and the pre-tighten originals are rebuilt by studio/tools/mix.mjs; the house kit by studio/tools/sounds.mjs
channel-system/episodes/*/audio/mix.wav
channel-system/episodes/*/audio/raw/
studio/assets/sounds/
channel-system/episodes/*/thumbnail_small.png
channel-system/episodes/*/shorts/*/audio/mix.wav
channel-system/episodes/*/shorts/*/audio/raw/
channel-system/episodes/*/render/
studio/gallery/render/
# Shorts: clips are copies of the episode's, mix and render are rebuilt
channel-system/episodes/*/shorts/*/render/
channel-system/episodes/*/shorts/*/audio/*.wav
